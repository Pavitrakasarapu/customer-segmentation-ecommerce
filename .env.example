# ================================================================
# Customer Segmentation E-Commerce Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit .env with production passwords to version control!
# ================================================================

# Flask Configuration
FLASK_ENV=production
# Generate a strong key, e.g. using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Configuration
# Leave empty or omit to use local SQLite: instance/customer_segmentation.db
# For PostgreSQL (Render / Production): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Administrator Credentials (Auto-verified or created on seed/initial startup)
ADMIN_NAME=Administrator
ADMIN_EMAIL=pavitrakasarapu@gmail.com
ADMIN_PASSWORD=Admin@123

# Mail / SMTP Configuration (Optional - used for Password Reset OTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@customersegment.local

# Machine Learning Artifacts Directory (Default: ml/artifacts)
ML_MODEL_DIR=ml/artifacts
